{
  "name": "logitrak-backend",
  "version": "1.0.0",
  "description": "API de logitrak: autenticación con roles, choferes y datos de logística sobre PostgreSQL (Supabase).",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --import ./src/observabilidad/instrument.js src/index.js",
    "dev": "node --watch --import ./src/observabilidad/instrument.js src/index.js",
    "db:init": "node src/db/init.js --standalone",
    "generar:cotizador": "node scripts/generar-cotizador.js",
    "test": "node --test",
    "migrar": "node scripts/migrar.js",
    "migrar:crear": "node-pg-migrate create --migrations-dir migrations --migration-file-language js"
  },
  "dependencies": {
    "@sentry/node": "^10.78.0",
    "@supabase/supabase-js": "^2.112.3",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.1",
    "helmet": "8.1.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.1.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "private": true,
  "devDependencies": {
    "esbuild": "0.25.11",
    "pino-pretty": "^13.2.0"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "^14.0.6"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
