# =============================================================================
# Logitrak · backend · STAGING
# -----------------------------------------------------------------------------
# Copialo a backend/.env.staging (no se commitea) y arrancá con:
#   ENTORNO=staging npm start
# Se carga primero este archivo y después backend/.env: lo que no esté acá sale
# del .env común. En Render no hace falta archivo: se define ENTORNO=staging y
# estas mismas variables en el panel del servicio.
#
# Staging es una copia de producción para probar antes de publicar: base y
# credenciales PROPIAS, nunca las de producción.
# =============================================================================

ENTORNO=staging

# Base de staging (otro proyecto de Supabase o una base aparte). Pooler en modo
# sesión, puerto 5432: las migraciones usan advisory locks.
DATABASE_URL=

# Distinto del de producción: un token de staging no tiene que servir allá.
JWT_SECRET=

# Mercado Pago con credenciales de PRUEBA (TEST-... o las del usuario de prueba).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_REEMBOLSOS_SIMULADOS=true

# Storage de staging (bucket privado).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=verificacion-identidad

GOOGLE_DIRECTIONS_KEY=

# Mismo proyecto de Sentry que producción: los eventos se separan por entorno.
SENTRY_DSN=
LOG_LEVEL=debug

# Orígenes extra permitidos por CORS (por ejemplo, la web de staging).
CORS_ORIGENES=
