# =============================================================================
# Logitrak · backend · PRODUCCIÓN
# -----------------------------------------------------------------------------
# En Render estas variables van en el panel del servicio (Environment), no en
# un archivo. Este listado es la referencia de qué tiene que estar cargado.
# Para correr localmente contra producción (no recomendado): copialo a
# backend/.env.produccion y arrancá con ENTORNO=produccion npm start.
#
# Al arrancar, la API revisa esta configuración: sin DATABASE_URL o JWT_SECRET
# no arranca, y lo recomendado que falte queda como aviso en el log y en
# GET /api/salud (avisosDeConfiguracion).
# =============================================================================

ENTORNO=produccion

# --- Obligatorias ---------------------------------------------------------
DATABASE_URL=
JWT_SECRET=

# --- Pagos ------------------------------------------------------------------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Recomendadas (si faltan, hay funciones que no andan) -----------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=verificacion-identidad
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
GOOGLE_DIRECTIONS_KEY=
SENTRY_DSN=
LOG_LEVEL=info
